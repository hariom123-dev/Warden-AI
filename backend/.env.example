# ==============================================================================
# Warden-AI Zero-Trust Security Gateway - Environment Configuration
# ==============================================================================
# Copy this file to .env before starting the server:
#   cp .env.example .env

# Server listening port for HTTP & WebSocket proxy (default: 3001)
PORT=3001

# Application environment (development | production | test)
NODE_ENV=development

# Path to SQLite audit trail database (supports cross-platform relative or absolute paths)
DB_PATH=./audit.db

# Allowed CORS Origins (use * for all or http://localhost:5173 for local frontend)
CORS_ORIGIN=*

# Cryptographic Decoy Honeypot IDS (true | false)
HONEYPOT_ENABLED=true
